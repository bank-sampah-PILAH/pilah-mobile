<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Pilah Mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Hands incoming deep links to the Flutter Router (GoRouter)
                 instead of the legacy Navigator API. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="true"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Invite links: https://<host>/invite?token=… opens the app so the
                 token can be captured without the user copying anything.
                 Scheme/host/path entries combine across the <data> tags below.

                 The host is the production Cloud Run API, derived from
                 BASE_URL_PROD. It has to match whatever the backend actually
                 puts in invite_url — that is PILAH_PUBLIC_APP_URL when it is
                 set, otherwise the incoming request host, which on Cloud Run is
                 this one. If PILAH_PUBLIC_APP_URL is ever pointed at a separate
                 web domain, add that host here too or the links stop resolving.

                 Both http and https are declared. Cloud Run only serves https,
                 but Django currently emits http:// invite links: it sits behind
                 Cloud Run's TLS terminator and config/settings.py sets no
                 SECURE_PROXY_SSL_HEADER, so request.build_absolute_uri() does
                 not know the original request was secure. Registering http keeps
                 those already-issued links working; the real fix belongs in the
                 backend.

                 autoVerify is on, but this filter does NOT open the app until
                 https://<host>/.well-known/assetlinks.json is served with this
                 app's package name and release SHA-256. We target SDK 36, and
                 since Android 12 an unverified http(s) link goes straight to the
                 browser rather than offering a chooser — verification is the
                 only thing that changes that. Until then, links open in Chrome.

                 The dev hosts (10.0.2.2, localhost) are not registered here, so
                 invite links do not open the app on the emulator. Restore them
                 in a debug-only manifest if that flow needs testing again. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
                <data android:host="pilah-be-hi6b7cbwta-et.a.run.app"/>
                <data android:pathPrefix="/invite"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
